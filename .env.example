PORT=3104
DATA_DIR=./data
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Login do profissional: a primeira conta é criada na própria página, na
# aba Área do profissional. Não há mais código compartilhado (PROF_CODE
# foi removido na v1.1).
# WhatsApp dos lembretes: escolha um provedor e preencha só o dele.
WHATSAPP_PROVIDER=
# WhatsApp oficial (Meta): WHATSAPP_PROVIDER=meta
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=
# CallMeBot: WHATSAPP_PROVIDER=callmebot
WHATSAPP_APIKEY=
# Contato interno para remarcação, nunca exibido na página pública.
WHATSAPP_INTERNO=
